---
import { Picture } from "astro:assets";
import Jenssen from "assets/olav-christopher-jenssen_2025_synonym.jpg";
---

<main class="py-9">
  <div class="flex flex-col items-center pt-0 pb-6">
    <Picture
      src={Jenssen}
      alt="Olav Christopher Jenssen, Synonym, 2025, Einladung"
      widths={[420, 740, 980]}
      sizes="(max-width: 900px) 100%, 800px"
      loading="eager"
      formats={['avif', 'webp']}
    />
    <div class="text-center">
      <p class="text-xs mt-1 text-hpg-600">Olav Christopher Jenssen, Synonym, 2025, Einladung Holger Priess Galerie</p>
    </div>
  </div>
  <div class="text-center pt-7 md:block">
    <h1
    class="text-4xl lg:text-4xl xl:text-5xl text-center font-bold hover:text-hpg-300 leading-none md:tracking-tight">
    Olav Christopher Jenssen
    </h1>
    <h2
    class="text-3xl lg:text-3xl xl:text-4xl text-center mt-2 font-bold hover:text-hpg-300 md:tracking-tight">
    Synonym
    </h2>
  </div>
  <div class="mt-3">   
    <p class="font-bold text-center mt-7 mb-5 text-hpg-700">
      5. September - 18. Oktober 2025<br/>
      Do, Fr 14 - 18 Uhr, Sa 12-15 Uhr und nach Vereinbarung</p>
  </div>
  <div class="my-5 md:my-1">
    <p class="text-hpg-700 text-base mt-4 leading-normal">
      Ich freue mich, zu einer neuen Ausstellung mit Arbeiten von Olav Christopher Jenssen einladen zu können.
    </p>
  </div>
  <div class="my-3 md:my-1">
    <p class="text-center font-bold text-hpg-600 hover:text-hpg-500 text-base mt-4 leading-normal">
      <a href="/pdf/olav-christopher-jenssen_synonym-2025m.pdf" download>Ausgestellte Werke von Olav Christopher Jenssen</a> (PDF, 17MB)
    </p>
  </div>
</main>
